<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_premium">

    <!-- WELCOME SCREEN CONTENT (Behind Bottom Sheet) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clWelcomeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Section (30%) -->
        <LinearLayout
            android:id="@+id/llTopSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/llMiddleSection"
            app:layout_constraintVertical_weight="0.3">
        </LinearLayout>

        <!-- Middle Section (45%) -->
        <LinearLayout
            android:id="@+id/llMiddleSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/llTopSection"
            app:layout_constraintBottom_toTopOf="@+id/llBottomSection"
            app:layout_constraintVertical_weight="0.45">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/logo_face_recognition" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PT Talangmas Anugerah Semesta"
                android:textColor="#000666"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast, Secure and Intelligent\nAttendance Management"
                android:textColor="#454652"
                android:textSize="14sp"
                android:textAlignment="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Bottom Section (25%) -->
        <LinearLayout
            android:id="@+id/llBottomSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/llMiddleSection"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_weight="0.25">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnGetStartedContainer"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_button_primary">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Get Started"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                        
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#FFFFFF"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.0 • Privacy Policy"
                android:textColor="#767683"
                android:textSize="12sp"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- Dim Overlay when Bottom Sheet opens -->
        <View
            android:id="@+id/vDimOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#90000000"
            android:alpha="0"
            android:visibility="gone"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LOGIN BOTTOM SHEET -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheetLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_skipCollapsed="true"
        android:background="@drawable/bg_bottom_sheet_rounded"
        android:elevation="24dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="48dp"
            android:paddingTop="12dp">

            <!-- Drag Handle -->
            <View
                android:id="@+id/bsHandle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="#c6c5d4"
                android:layout_marginBottom="24dp"/>

            <!-- Center Header Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <!-- Mini Glowing Logo Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5EEFF"
                    app:cardBackgroundColor="#F8F9FF"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo_face_recognition"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/bsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back"
                    android:textColor="#000666"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textAlignment="center"/>

                <TextView
                    android:id="@+id/bsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in to your employee account"
                    android:textColor="#454652"
                    android:textSize="14sp"
                    android:textAlignment="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Form Container (Staggered Animation target) -->
            <LinearLayout
                android:id="@+id/llFormContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="#0f1c2d"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/llEmailWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_outline"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="#767683" />
                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="name@talangmas.co.id"
                        android:inputType="textEmailAddress"
                        android:textColor="#0f1c2d"
                        android:textColorHint="#c6c5d4"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="#0f1c2d"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/llPasswordWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_outline"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock_outline"
                        app:tint="#767683" />
                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:textColor="#0f1c2d"
                        android:textColorHint="#c6c5d4"
                        android:textSize="16sp" />
                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_eye"
                        app:tint="#767683" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <CheckBox
                        android:id="@+id/cbRemember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remember me"
                        android:textColor="#454652"
                        android:buttonTint="#000666"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot Password?"
                        android:textColor="#000666"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>

                <!-- Login Action -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnLoginContainer"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="32dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_button_primary">
                        
                        <TextView
                            android:id="@+id/tvLoginText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Sign In"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                            
                        <ProgressBar
                            android:id="@+id/pbLoginLoading"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Flowing Navy Ribbon Waves Decoration -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="32dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_flowing_navy_ribbon_waves" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
