<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content">

    <!-- Top Half Line -->
    <View android:id="@+id/vLineTop" android:layout_width="1dp" android:layout_height="0dp" android:background="#D1D5DB" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/flDotContainer" app:layout_constraintStart_toStartOf="@id/flDotContainer" app:layout_constraintEnd_toEndOf="@id/flDotContainer" />

    <!-- Bottom Half Line -->
    <View android:id="@+id/vLineBottom" android:layout_width="1dp" android:layout_height="0dp" android:background="#D1D5DB" app:layout_constraintTop_toBottomOf="@id/flDotContainer" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/flDotContainer" app:layout_constraintEnd_toEndOf="@id/flDotContainer" />

    <!-- Dot Container -->
    <FrameLayout android:id="@+id/flDotContainer" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginStart="16dp" android:layout_marginTop="20dp" android:background="@drawable/bg_circle_white" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

        <!-- Inner Dot -->
        <View android:id="@+id/vInnerDot" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="center" android:background="@drawable/bg_circle_primary" />
    </FrameLayout>

    <TextView android:id="@+id/tvRelativeDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textSize="10sp" android:textColor="#737685" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/flDotContainer" app:layout_constraintStart_toStartOf="@id/flDotContainer" app:layout_constraintEnd_toEndOf="@id/flDotContainer" />

    <!-- Card -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardContainer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="8dp" app:cardElevation="2dp" app:strokeWidth="0dp" app:layout_constraintStart_toEndOf="@id/flDotContainer" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

            <!-- Card Header: Date & Status Badge -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">

                <TextView android:id="@+id/tvDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wed, Oct 25" android:textColor="#011D35" android:textSize="14sp" android:textStyle="bold" />

                <TextView android:id="@+id/tvAccuracy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="Acc: 98%" android:textColor="#10B981" android:textSize="12sp" android:textStyle="bold" />

                <!-- Status Badge -->
                <LinearLayout android:id="@+id/llStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_light_primary" android:paddingHorizontal="6dp" android:paddingVertical="2dp">
                    <TextView android:id="@+id/tvStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="On Time" android:textColor="#0052CC" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Check In Row -->
            <LinearLayout android:id="@+id/llCheckInRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">

                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_exit" android:rotation="180" app:tint="#737685" />

                <TextView android:id="@+id/tvCheckInTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="08:55 AM" android:textColor="#434654" android:textSize="14sp" />
            </LinearLayout>

            <!-- Check Out Row -->
            <LinearLayout android:id="@+id/llCheckOutRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_exit" app:tint="#737685" />

                <TextView android:id="@+id/tvCheckOutTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="--:--" android:textColor="#434654" android:textSize="14sp" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <TextView android:id="@+id/tvTotalHours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active" android:textColor="#0052CC" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            
            <!-- Leave Info Row (Hidden by default) -->
            <LinearLayout android:id="@+id/llLeaveInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/tvLeaveReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reason: Sick leave" android:textColor="#434654" android:textSize="14sp" android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
