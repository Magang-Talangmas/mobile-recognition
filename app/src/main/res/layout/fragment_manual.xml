<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/html_background" android:fitsSystemWindows="true">

    <!-- AppBar containing Header -->
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" app:elevation="0dp">

        <!-- Top Header -->
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="72dp" android:paddingHorizontal="16dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" android:src="@drawable/logo_face_recognition" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manual Entry" android:textColor="@color/html_primary" android:textSize="24sp" android:textStyle="bold" />
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="100dp" app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="8dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gunakan formulir ini untuk merekam kehadiran jika pemindai biometrik offline atau tidak dapat memproses permintaan Anda." android:textColor="@color/html_on_surface_variant" android:textSize="16sp" android:layout_marginTop="8dp" />

            <!-- Info Card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_surface_container" android:padding="16dp" android:layout_marginTop="24dp" android:gravity="top">

                <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_circle_primary" android:layout_marginEnd="12dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@android:drawable/ic_dialog_info" app:tint="@color/html_on_primary_container"/>
                </FrameLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kapan menggunakan ini" android:textColor="@color/html_on_surface" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entri manual memerlukan persetujuan atasan. Pastikan foto selfie Anda menunjukkan wajah dan lokasi dengan jelas." android:textColor="@color/html_on_surface_variant" android:textSize="14sp" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Loading State -->
            <LinearLayout android:id="@+id/loadingState" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginTop="64dp" android:visibility="visible">

                <ProgressBar android:layout_width="48dp" android:layout_height="48dp" android:indeterminateTint="@color/html_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Memeriksa status Anda..." android:textColor="@color/html_on_surface_variant" android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- Form Container -->
            <LinearLayout android:id="@+id/formContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="32dp" android:visibility="gone">

                <!-- <TextView android:id="@+id/tvActionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good Morning! Ready to start?" android:textColor="@color/html_on_background" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="16dp"/> -->

                <!-- Date & Time Row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">

                    <!-- Date -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tanggal" android:textColor="@color/html_on_surface_variant" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="52dp" app:cardBackgroundColor="@color/html_surface" app:cardCornerRadius="8dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                            <TextView android:id="@+id/etDate" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:drawablePadding="12dp" android:drawableStart="@android:drawable/ic_menu_today" android:textColor="@color/html_on_surface" android:textSize="16sp"/>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Time -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Waktu" android:textColor="@color/html_on_surface_variant" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="52dp" app:cardBackgroundColor="@color/html_surface" app:cardCornerRadius="8dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                            <TextView android:id="@+id/etTime" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:drawablePadding="12dp" android:drawableStart="@android:drawable/ic_menu_recent_history" android:textColor="@color/html_on_surface" android:textSize="16sp"/>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

                <!-- No entry type toggle anymore -->


                <!-- Verification (Photo) -->
                <TextView android:id="@+id/tvVerificationTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verifikasi" android:textColor="@color/html_on_background" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="32dp" android:layout_marginBottom="16dp"/>

                <TextView android:id="@+id/tvSelfieLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unggah Selfie" android:textColor="@color/html_on_surface_variant" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>



                <FrameLayout android:id="@+id/flPhotoUpload" android:layout_width="match_parent" android:layout_height="220dp" android:background="@drawable/bg_photo_upload" android:clickable="true" android:focusable="true">

                    <LinearLayout android:id="@+id/llUploadPlaceholder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="center" android:gravity="center">
                        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_camera" app:tint="@color/html_outline"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ketuk untuk selfie\nDiperlukan untuk verifikasi" android:textAlignment="center" android:textSize="16sp" android:textColor="@color/html_on_surface_variant" android:layout_marginTop="12dp"/>
                    </LinearLayout>

                    <ImageView android:id="@+id/ivPhotoPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />

                    <ImageButton android:id="@+id/btnRemovePhoto" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_margin="12dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:background="@drawable/bg_circle_inverse" android:visibility="gone" app:tint="@android:color/white"/>
                </FrameLayout>

                <Button android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="56dp" android:text="Kirim Pengajuan" android:backgroundTint="@color/html_primary" android:textColor="@color/html_on_primary" android:textSize="16sp" android:layout_marginTop="32dp" app:cornerRadius="28dp"/>
            </LinearLayout>

            <!-- Success State -->
            <LinearLayout android:id="@+id/successState" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:visibility="gone" android:layout_marginTop="64dp">

                <FrameLayout android:layout_width="80dp" android:layout_height="80dp" android:background="@drawable/bg_circle_primary" android:layout_marginBottom="24dp">
                    <ImageView android:id="@+id/ivSuccessAnim" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/avd_anim_success_check" />
                </FrameLayout>

                <TextView android:id="@+id/tvSuccessTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Selesai untuk hari ini!" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/html_on_background"/>

                <TextView android:id="@+id/tvSuccessSubtitle" android:layout_width="300dp" android:layout_height="wrap_content" android:text="Anda telah berhasil menyelesaikan absensi hari ini." android:textAlignment="center" android:textSize="18sp" android:textColor="@color/html_on_surface_variant" android:layout_marginTop="12dp"/>

                <!-- Submit Another button removed since it's conditional now -->
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
