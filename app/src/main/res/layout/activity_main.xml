<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ent_background">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        app:backgroundTint="@color/ent_surface"
        app:fabCradleMargin="8dp"
        app:fabCradleRoundedCornerRadius="24dp"
        app:fabCradleVerticalOffset="0dp"
        app:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="12dp"
            android:gravity="center_vertical">

            <!-- Item 1: Dashboard -->
            <RelativeLayout
                android:id="@+id/navDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/iconDashboard"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_nav_dashboard" />
                <View
                    android:id="@+id/dotDashboard"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_below="@id/iconDashboard"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_nav_dot"
                    android:visibility="invisible" />
            </RelativeLayout>

            <!-- Item 2: Quick Izin -->
            <RelativeLayout
                android:id="@+id/navQuickIzin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/iconQuickIzin"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_calendar" />
                <View
                    android:id="@+id/dotQuickIzin"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_below="@id/iconQuickIzin"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_nav_dot"
                    android:visibility="invisible" />
            </RelativeLayout>

            <!-- Spacer for FAB -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Item 3: History -->
            <RelativeLayout
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/iconHistory"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_nav_history" />
                <View
                    android:id="@+id/dotHistory"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_below="@id/iconHistory"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_nav_dot"
                    android:visibility="invisible" />
            </RelativeLayout>

            <!-- Item 4: Profile -->
            <RelativeLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/iconProfile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_nav_profile" />
                <View
                    android:id="@+id/dotProfile"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_below="@id/iconProfile"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_nav_dot"
                    android:visibility="invisible" />
            </RelativeLayout>

        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabManual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_nav_manual"
        app:backgroundTint="@color/ent_secondary"
        app:tint="@color/ent_primary"
        app:layout_anchor="@id/bottomAppBar"
        app:fabCustomSize="56dp"
        app:maxImageSize="32dp"
        app:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
