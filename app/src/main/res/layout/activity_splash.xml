<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_premium">

    <!-- Center Container -->
    <FrameLayout
        android:id="@+id/flLogoContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toTopOf="@+id/tvCompanyName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="48dp">

        <!-- Glowing background behind logo -->
        <View
            android:id="@+id/vGlow"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_inverse"
            android:backgroundTint="#20FEB300"
            android:scaleX="1.5"
            android:scaleY="1.5"
            android:alpha="0"/>

        <!-- Orbit Ring -->
        <ImageView
            android:id="@+id/ivOrbit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_golden_orbit"
            android:alpha="0"/>

        <!-- Main Logo -->
        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/logo_face_recognition"
            android:alpha="0"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvCompanyName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TALANGMAS ANUGERAH SEMESTA"
        android:textColor="#000666"
        android:textSize="14sp"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        android:textAlignment="center"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flLogoContainer" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Talang Attendance"
        android:textColor="#454652"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCompanyName" />

</androidx.constraintlayout.widget.ConstraintLayout>
