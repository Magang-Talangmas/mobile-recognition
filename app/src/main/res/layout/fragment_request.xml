<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundLight"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvRequestHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Form Pengajuan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilType"
            style="@style/Widget.App.TextInputLayout"
            app:boxBackgroundColor="@color/inputBackground"
            app:boxStrokeColor="@color/cardStroke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipe Pengajuan"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvRequestHeader">

            <AutoCompleteTextView
                android:id="@+id/spinnerType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilReason"
            style="@style/Widget.App.TextInputLayout"
            app:boxBackgroundColor="@color/inputBackground"
            app:boxStrokeColor="@color/cardStroke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alasan / Keterangan"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tilType">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:textColor="@color/textPrimary"
                android:lines="4"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAttach"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Lampirkan Dokumen/Foto"
            android:textColor="@color/textPrimary"
            app:strokeColor="@color/cardStroke"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconTint="@color/textPrimary"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tilReason"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAttachmentPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            app:cornerSize="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnAttach"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Kirim Pengajuan"
            android:textSize="16sp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/ivAttachmentPreview" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
