<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JavaTraining" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/textWhite</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/textWhite</item>
        
        <!-- Background and Surface -->
        <item name="android:colorBackground">@color/backgroundLight</item>
        <item name="colorSurface">@color/cardBackground</item>
        <item name="colorOnBackground">@color/textPrimary</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/backgroundLight</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Style for Circular Images -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Premium Rounded Input -->
    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/inputBackground</item>
        <item name="boxStrokeColor">@color/cardStroke</item>
        <item name="android:textColorHint">@color/textSecondary</item>
    </style>

    <!-- Premium Button -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>